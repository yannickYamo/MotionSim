    },
    "current_sampling": {
      "kind": "current_sampling",
      "title": "Current sampling",
      "definition": "Reads two phase currents at the sampling instant (the carrier's peak, where the ripple passes through its mean) and makes the third from them; a sensor's noise, offset, gain error and the converter's steps are added where given.",
      "math": [
        "\\hat i_a = \\mathrm{Q}\\!\\left[(1+g)\\,i_a + o + n\\right]",
        "\\hat i_b = \\mathrm{Q}\\!\\left[i_b + n\\right]",
        "\\hat i_c = -\\hat i_a - \\hat i_b"
      ],
      "linear": false,
      "loop": "",
      "inputs": [
        { "name": "i_a", "unit": "A", "about": "phase a current" },
        { "name": "i_b", "unit": "A", "about": "phase b current" },
        { "name": "i_c", "unit": "A", "about": "phase c current" }
      ],
      "outputs": [
        { "name": "i_a", "unit": "A", "about": "sampled phase a current" },
        { "name": "i_b", "unit": "A", "about": "sampled phase b current" },
        { "name": "i_c", "unit": "A", "about": "phase c current made from the other two" }
      ],
      "params": [
        {
          "name": "noise",
          "unit": "A",
          "value": 0.0,
          "default": 0.0,
          "low": 0.0,
          "high": 10000.0,
          "choices": [],
          "about": "gaussian noise on each sample, rms",
          "source": ""
        },
        {
          "name": "offset",
          "unit": "A",
          "value": 0.0,
          "default": 0.0,
          "low": -10000.0,
          "high": 10000.0,
          "choices": [],
          "about": "offset of the phase a sensor",
          "source": ""
        },
        {
          "name": "gain_error",
          "unit": "",
          "value": 0.0,
          "default": 0.0,
          "low": -0.5,
          "high": 0.5,
          "choices": [],
          "about": "gain error of the phase a sensor, as a share",
          "source": ""
        },
        {
          "name": "bits",
          "unit": "bit",
          "value": 0.0,
          "default": 0.0,
          "low": 0.0,
          "high": 24.0,
          "choices": [],
          "about": "resolution of the converter; 0 for none",
          "source": ""
        },
        {
          "name": "full_scale",
          "unit": "A",
          "value": 100.0,
          "default": 100.0,
          "low": 0.001,
          "high": 1000000.0,
          "choices": [],
          "about": "current at the converter's full scale, either way",
          "source": ""
        }
      ]
    },
    "fcs_mpc": {
      "kind": "fcs_mpc",
      "title": "Predictive current control (finite control set)",
      "definition": "Chooses the state of the three legs directly, with no modulator: of the eight, the one whose predicted current one step on lies nearest the reference, a commutation costing \u03bb amperes. With the one-sample delay, the current is first predicted to the instant the choice takes effect.",
      "math": [
        "i_{dq}[k+1] = i_{dq}[k] + T_s\\,L^{-1}\\!\\left(v_{dq}(s) - R\\,i_{dq}[k] - \\omega_e J L\\,i_{dq}[k] - \\omega_e \\psi\\,e_q\\right)",
        "g(s) = \\left|i_d^* - i_d[k+2]\\right| + \\left|i_q^* - i_q[k+2]\\right| + \\lambda\\,n_{sw}(s, s_{k+1})",
        "s_{k+1}^{\\,next} = \\arg\\min_{s \\in \\{0..7\\}} g(s)"
      ],
      "linear": false,
      "loop": "current",
      "inputs": [
        { "name": "id_ref", "unit": "A", "about": "d-axis current reference" },
        { "name": "iq_ref", "unit": "A", "about": "q-axis current reference" },
        { "name": "i_d", "unit": "A", "about": "d-axis current as measured" },
        { "name": "i_q", "unit": "A", "about": "q-axis current as measured" },
        { "name": "theta", "unit": "rad", "about": "electrical angle" },
        { "name": "omega_e", "unit": "rad/s", "about": "electrical speed" },
        { "name": "v_dc", "unit": "V", "about": "DC voltage" }
      ],
      "outputs": [
        { "name": "s_a", "unit": "", "about": "leg a: 1 with the high side on" },
        { "name": "s_b", "unit": "", "about": "leg b: 1 with the high side on" },
        { "name": "s_c", "unit": "", "about": "leg c: 1 with the high side on" },
        { "name": "cost", "unit": "A", "about": "cost of the state chosen" }
      ],
      "params": [
        {
          "name": "weight",
          "unit": "A",
          "value": 0.0,
          "default": 0.0,
          "low": 0.0,
          "high": 1000000.0,
          "choices": [],
          "about": "\u03bb: what one leg's commutation costs, in amperes of current error",
          "source": ""
        },
        {
          "name": "delay_compensation",
          "unit": "",
          "value": true,
          "default": true,
          "low": null,
          "high": null,
          "choices": [],
          "about": "predict to the instant the choice takes effect first",
          "source": ""
        }
      ]
    },
    "inverse_park": {
      "kind": "inverse_park",
      "title": "Inverse Park transform",
      "definition": "Rotor-frame voltages turned back to the stator's frame, at the angle the rotor will have reached when the voltage is applied: `advance` sampling periods ahead (1.5 with a one-sample delay: the delay, and half the period the voltage is held for; 0.5 without).",
      "math": [
        "\\theta' = \\theta + a\\,\\omega_e T_s",
        "v_\\alpha = v_d\\cos\\theta' - v_q\\sin\\theta'",
        "v_\\beta = v_d\\sin\\theta' + v_q\\cos\\theta'"
      ],
      "linear": false,
      "loop": "",
      "inputs": [
        { "name": "d", "unit": "V", "about": "d-axis voltage" },
        { "name": "q", "unit": "V", "about": "q-axis voltage" },
        { "name": "theta", "unit": "rad", "about": "electrical angle" },
        { "name": "omega_e", "unit": "rad/s", "about": "electrical speed" }
      ],
      "outputs": [
        { "name": "alpha", "unit": "V", "about": "along phase a" },
        { "name": "beta", "unit": "V", "about": "a quarter turn ahead" }
      ],
      "params": [
        {
          "name": "advance",
          "unit": "samples",
          "value": 1.5,
          "default": 1.5,
          "low": 0.0,
          "high": 4.0,
          "choices": [],
          "about": "sampling periods the angle is advanced by",
          "source": ""
        }
      ]
    },
    "modulator": {
      "kind": "modulator",
      "title": "Modulator",
      "definition": "Turns the voltage asked for into the three legs' duty cycles: each phase's share of half the DC voltage, shifted together by the scheme's zero-sequence signal (the same shifts the loss engine uses), and held between 0 and 1.",
      "math": [
        "u_x = \\frac{v_x}{V_{dc}/2},\\quad x \\in \\{a,b,c\\}",
        "d_x = \\mathrm{clip}\\!\\left(\\tfrac12\\,(1 + u_x + u_0),\\,0,\\,1\\right)",
        "u_0 = -\\tfrac12\\left(\\max u_x + \\min u_x\\right)\\ \\text{(space-vector)}"
      ],
      "linear": false,
      "loop": "",
      "inputs": [
        { "name": "alpha", "unit": "V", "about": "voltage along phase a" },
        { "name": "beta", "unit": "V", "about": "voltage a quarter turn ahead" },
        { "name": "v_dc", "unit": "V", "about": "DC voltage" }
      ],
      "outputs": [
        { "name": "d_a", "unit": "", "about": "duty cycle of leg a's high side" },
        { "name": "d_b", "unit": "", "about": "duty cycle of leg b's high side" },
        { "name": "d_c", "unit": "", "about": "duty cycle of leg c's high side" },
        { "name": "m", "unit": "", "about": "modulation index asked for" }
      ],
      "params": [
        {
          "name": "pwm",
          "unit": "",
          "value": "space-vector",
          "default": "space-vector",
          "low": null,
          "high": null,
          "choices": [
            "sine",
            "third-harmonic",
            "space-vector",
            "discontinuous",
            "discontinuous-high",
            "discontinuous-low"
          ],
          "about": "how the three references are shifted",
          "source": ""
        }
      ]
    },
    "park": {
      "kind": "park",
      "title": "Park transform",
      "definition": "Stator-frame quantities seen from the rotor: d along the magnet, q a quarter turn ahead.",
      "math": [
        "x_d = x_\\alpha\\cos\\theta + x_\\beta\\sin\\theta",
        "x_q = -x_\\alpha\\sin\\theta + x_\\beta\\cos\\theta"
      ],
      "linear": false,
      "loop": "",
      "inputs": [
        { "name": "alpha", "unit": "", "about": "stator-frame component along phase a" },
        { "name": "beta", "unit": "", "about": "stator-frame component a quarter turn ahead" },
        { "name": "theta", "unit": "rad", "about": "electrical angle" }
      ],
      "outputs": [
        { "name": "d", "unit": "", "about": "along the magnet" },
        { "name": "q", "unit": "", "about": "a quarter turn ahead of it" }
      ],
      "params": []
    },
    "position_sensing": {
      "kind": "position_sensing",
      "title": "Position sensing",
      "definition": "Gives the controller the rotor's angle and speed: as they are (ideal), or as an encoder of so many counts a turn reads them, so many seconds late, with the speed taken from the counts over a window.",
      "math": [
        "\\hat\\theta_m[k] = \\frac{2\\pi}{N}\\left\\lfloor \\frac{N\\,\\theta_m(t_k - T_\\ell)}{2\\pi} \\right\\rfloor",
        "\\hat\\omega_m[k] = \\frac{\\hat\\theta_m[k] - \\hat\\theta_m[k-W]}{W\\,T_s}",
        "\\hat\\theta_e = p\\,\\hat\\theta_m"
      ],
      "linear": false,
      "loop": "",
      "inputs": [
        { "name": "theta", "unit": "rad", "about": "the rotor's electrical angle" },
        { "name": "omega_m", "unit": "rad/s", "about": "the shaft's speed" }
