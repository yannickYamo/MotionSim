  "blocks": {
    "clarke": {
      "kind": "clarke",
      "title": "Clarke transform",
      "definition": "Three phase currents as two in the stator's own axes (amplitude kept).",
      "math": [
        "i_\\alpha = \\tfrac{2}{3}\\left(i_a - \\tfrac12 i_b - \\tfrac12 i_c\\right)",
        "i_\\beta = \\tfrac{1}{\\sqrt3}\\left(i_b - i_c\\right)"
      ],
      "linear": false,
      "loop": "",
      "inputs": [
        { "name": "a", "unit": "A", "about": "phase a" },
        { "name": "b", "unit": "A", "about": "phase b" },
        { "name": "c", "unit": "A", "about": "phase c" }
      ],
      "outputs": [
        { "name": "alpha", "unit": "A", "about": "along phase a" },
        { "name": "beta", "unit": "A", "about": "a quarter turn ahead" }
      ],
      "params": []
    },
    "current_pi_dq": {
      "kind": "current_pi_dq",
      "title": "Current regulator (PI, rotor frame)",
      "definition": "Asks the d- and q-axis voltages that close the current errors: a PI on each axis, with the cross-coupling between the axes and the back-EMF fed forward (each can be switched off), held inside the circle of voltage the modulation reaches, the integrals held while it holds. Tuned by cancelling the winding's pole: Kp = \u03c9c\u00b7L and Ki = \u03c9c\u00b7R, with \u03c9c the bandwidth asked for.",
      "math": [
        "v_d^* = K_{pd}\\,e_d + K_{id}\\!\\int e_d\\,dt - \\omega_e L_q i_q",
        "v_q^* = K_{pq}\\,e_q + K_{iq}\\!\\int e_q\\,dt + \\omega_e L_d i_d + \\omega_e \\psi",
        "\\sqrt{v_d^2 + v_q^2} \\le k\\,m_{max}\\,\\tfrac{V_{dc}}{2}",
        "C(z) = K_p + K_i T_s \\frac{z}{z-1}"
      ],
      "linear": true,
      "loop": "current",
      "inputs": [
        { "name": "id_ref", "unit": "A", "about": "d-axis current reference" },
        { "name": "iq_ref", "unit": "A", "about": "q-axis current reference" },
        { "name": "i_d", "unit": "A", "about": "d-axis current as measured" },
        { "name": "i_q", "unit": "A", "about": "q-axis current as measured" },
        { "name": "omega_e", "unit": "rad/s", "about": "electrical speed" },
        { "name": "v_dc", "unit": "V", "about": "DC voltage" }
      ],
      "outputs": [
        { "name": "v_d", "unit": "V", "about": "d-axis voltage asked for" },
        { "name": "v_q", "unit": "V", "about": "q-axis voltage asked for" },
        { "name": "err_d", "unit": "A", "about": "d-axis current error" },
        { "name": "err_q", "unit": "A", "about": "q-axis current error" },
        { "name": "limited", "unit": "", "about": "1 while the voltage limit holds" }
      ],
      "params": [
        {
          "name": "kp_d",
          "unit": "V/A",
          "value": 1.0,
          "default": 1.0,
          "low": 0.0,
          "high": 1000000000000.0,
          "choices": [],
          "about": "proportional gain, d axis",
          "source": ""
        },
        {
          "name": "ki_d",
          "unit": "V/(A\u00b7s)",
          "value": 100.0,
          "default": 100.0,
          "low": 0.0,
          "high": 1000000000000.0,
          "choices": [],
          "about": "integral gain, d axis",
          "source": ""
        },
        {
          "name": "kp_q",
          "unit": "V/A",
          "value": 1.0,
          "default": 1.0,
          "low": 0.0,
          "high": 1000000000000.0,
          "choices": [],
          "about": "proportional gain, q axis",
          "source": ""
        },
        {
          "name": "ki_q",
          "unit": "V/(A\u00b7s)",
          "value": 100.0,
          "default": 100.0,
          "low": 0.0,
          "high": 1000000000000.0,
          "choices": [],
          "about": "integral gain, q axis",
          "source": ""
        },
        {
          "name": "decoupling",
          "unit": "",
          "value": true,
          "default": true,
          "low": null,
          "high": null,
          "choices": [],
          "about": "feed the cross-coupling between the axes forward",
          "source": ""
        },
        {
          "name": "bemf_feedforward",
          "unit": "",
          "value": true,
          "default": true,
