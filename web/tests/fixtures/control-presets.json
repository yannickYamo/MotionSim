    "speed_pi": {
      "kind": "speed_pi",
      "title": "Speed regulator (PI)",
      "definition": "Asks the torque that closes the speed error: proportional and integral, held to a torque limit, the integral stopped while the limit holds (anti-windup). Tuned by symmetric optimum, a decade below the current loop.",
      "math": [
        "e = \\omega^* - \\omega",
