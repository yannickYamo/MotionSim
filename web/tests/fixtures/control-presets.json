          "source": ""
        }
      ]
    },
    "current_reference": {
      "kind": "current_reference",
      "title": "Torque to current reference",
      "definition": "The d- and q-axis currents that make the torque: the pair of least current, and field weakening where the voltage runs out, both worked out by the same solver the loss engine settles its currents with; or the d-axis current held at nought. Held to the drive's current limit.",
      "math": [
        "T = \\tfrac32\\,p\\,\\left(\\psi\\,i_q + (L_d - L_q)\\,i_d\\,i_q\\right)",
        "\\min\\ i_d^2 + i_q^2 \\quad \\text{(least current)}",
        "v_d^2 + v_q^2 \\le \\left(k\\,m_{max}\\,\\tfrac{V_{dc}}{2}\\right)^2 \\quad \\text{(field weakening)}"
      ],
      "linear": false,
      "loop": "",
      "inputs": [
        { "name": "torque", "unit": "N\u00b7m", "about": "torque asked for" },
        { "name": "omega_m", "unit": "rad/s", "about": "shaft speed as sensed" },
        { "name": "v_dc", "unit": "V", "about": "DC voltage" }
      ],
      "outputs": [
        { "name": "i_d", "unit": "A", "about": "d-axis current reference" },
        { "name": "i_q", "unit": "A", "about": "q-axis current reference" }
      ],
      "params": [
        {
          "name": "strategy",
          "unit": "",
          "value": "mtpa_fw",
          "default": "mtpa_fw",
          "low": null,
          "high": null,
          "choices": ["mtpa_fw", "id_zero"],
          "about": "least current with field weakening, or id = 0",
          "source": ""
        },
        {
          "name": "i_limit",
          "unit": "A",
          "value": 1000000000000.0,
          "default": 1000000000000.0,
          "low": 0.0,
          "high": 1000000000000.0,
          "choices": [],
          "about": "most current asked for, peak",
          "source": ""
        },
        {
          "name": "voltage_share",
          "unit": "",
          "value": 1.0,
          "default": 1.0,
          "low": 0.1,
          "high": 1.0,
          "choices": [],
          "about": "share of the modulation's linear range field weakening keeps to",
          "source": ""
        },
        {
          "name": "torque_grid",
          "unit": "N\u00b7m",
          "value": 0.0,
          "default": 0.0,
          "low": 0.0,
          "high": 1000000000000.0,
          "choices": [],
          "about": "grid of torque the solver is read between while moving; 0: asked at every value",
          "source": ""
        },
        {
          "name": "speed_grid",
          "unit": "rad/s",
          "value": 0.0,
          "default": 0.0,
          "low": 0.0,
