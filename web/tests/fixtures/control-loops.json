{
  "scheme": {
    "id": "foc_servo",
    "label": "Cascaded speed and current control (servo)",
    "about": "A speed regulator asks a torque, a current regulator in the rotor's frame makes it: the usual field-oriented servo, sampled once a carrier period with one period of computation.",
    "timing": { "update": "single", "delay": true, "f_control": null },
    "actuation": { "kind": "duties", "wires": ["modulator.d_a", "modulator.d_b", "modulator.d_c"] },
    "blocks": [
      {
        "name": "sample",
        "kind": "current_sampling",
        "inputs": { "i_a": "plant.i_a", "i_b": "plant.i_b", "i_c": "plant.i_c" },
        "params": {},
        "sources": {}
      },
      {
        "name": "position",
        "kind": "position_sensing",
        "inputs": { "theta": "plant.theta_e", "omega_m": "plant.omega_m" },
        "params": {},
        "sources": {}
      },
      {
        "name": "clarke",
        "kind": "clarke",
        "inputs": { "a": "sample.i_a", "b": "sample.i_b", "c": "sample.i_c" },
        "params": {},
        "sources": {}
      },
      {
        "name": "park",
        "kind": "park",
        "inputs": { "alpha": "clarke.alpha", "beta": "clarke.beta", "theta": "position.theta" },
        "params": {},
        "sources": {}
      },
      {
        "name": "speed_ref",
        "kind": "speed_reference",
        "inputs": { "target": "cmd.speed" },
        "params": { "shape": "step", "slew": 837.76, "jerk": 526380.0 },
        "sources": {
          "slew": "the acceleration the torque limit gives the inertia with no load",
          "jerk": "that acceleration reached in one time constant of the speed loop"
        }
      },
      {
        "name": "speed",
        "kind": "speed_pi",
        "inputs": { "ref": "speed_ref.ref", "speed": "position.omega_m" },
        "params": { "kp": 3.5086, "ki": 324.34, "limit": 4.6782 },
        "sources": {
          "kp": "symmetric optimum a decade below the current loop (\u03c9s/2\u03c0 = 100 Hz, a = 6.8): Kp = J\u00b7\u03c9s, J = 0.00558 kg\u00b7m\u00b2.",
          "ki": "symmetric optimum a decade below the current loop (\u03c9s/2\u03c0 = 100 Hz, a = 6.8): Ki = Kp\u00b7\u03c9s/a",
          "limit": "the torque of the drive's current limit"
        }
      },
      {
        "name": "shaper",
        "kind": "torque_shaper",
        "inputs": { "torque": "speed.torque" },
        "params": { "shape": "step", "limit": 4.6782, "rate": 5878.8, "jerk": 14775000.0 },
        "sources": {
          "limit": "the torque of the drive's current limit",
          "rate": "the whole torque limit in half the speed loop's time constant, 1/(2\u00b7\u03c9s)",
          "jerk": "that rate reached in a quarter of the speed loop's time constant"
        }
      },
      {
        "name": "current_ref",
        "kind": "current_reference",
        "inputs": { "torque": "shaper.torque", "omega_m": "position.omega_m", "v_dc": "plant.v_dc" },
        "params": {
          "strategy": "mtpa_fw",
          "i_limit": 56.569,
          "voltage_share": 0.99222,
          "torque_grid": 0.073097,
          "speed_grid": 3.2725
        },
        "sources": {
          "i_limit": "the motor's current limit",
          "voltage_share": "the share of the ideal voltage the stage gives at the design point (dead time, shortest pulse and the devices' drop), as the loss engine takes it",
          "torque_grid": "1/64 of the torque limit",
          "speed_grid": "1/64 of the design speed"
        }
      },
      {
        "name": "current",
        "kind": "current_pi_dq",
        "inputs": {
          "id_ref": "current_ref.i_d",
          "iq_ref": "current_ref.i_q",
          "i_d": "park.d",
          "i_q": "park.q",
          "omega_e": "position.omega_e",
          "v_dc": "plant.v_dc"
        },
        "params": { "kp_d": 0.75398, "ki_d": 282.74, "kp_q": 0.75398, "ki_q": 282.74 },
        "sources": {
          "kp_d": "pole-zero cancellation at \u03c9c/2\u03c0 = 1,000 Hz (a twentieth of the 20,000 Hz sampling rate): Kp = \u03c9c\u00b7Ld",
          "ki_d": "pole-zero cancellation at \u03c9c/2\u03c0 = 1,000 Hz (a twentieth of the 20,000 Hz sampling rate): Ki = \u03c9c\u00b7Rs",
          "kp_q": "pole-zero cancellation at \u03c9c/2\u03c0 = 1,000 Hz (a twentieth of the 20,000 Hz sampling rate): Kp = \u03c9c\u00b7Lq",
          "ki_q": "pole-zero cancellation at \u03c9c/2\u03c0 = 1,000 Hz (a twentieth of the 20,000 Hz sampling rate): Ki = \u03c9c\u00b7Rs"
        }
      },
      {
        "name": "inverse_park",
        "kind": "inverse_park",
        "inputs": { "d": "current.v_d", "q": "current.v_q", "theta": "position.theta", "omega_e": "position.omega_e" },
        "params": { "advance": 1.5 },
        "sources": { "advance": "the delay around the loop in sampling periods: half the hold, and the computation" }
      },
      {
        "name": "modulator",
        "kind": "modulator",
        "inputs": { "alpha": "inverse_park.alpha", "beta": "inverse_park.beta", "v_dc": "plant.v_dc" },
        "params": { "pwm": "space-vector" },
        "sources": { "pwm": "the modulation of the design" }
      }
    ]
  },
  "tuning": { "bandwidth_hz": 1000.0, "delay_s": 7.5e-5, "rule": "a twentieth of the 20,000 Hz sampling rate" },
  "assumes": [
    "each axis is taken alone: the cross-coupling between the axes is fed forward exactly, or the rotor is still",
    "no voltage limit and no current limit is reached",
    "the rotor's angle is known exactly, and the speed with no lag",
    "the shaft has inertia and nothing else"
  ],
