    "engine-check": "node scripts/engine-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "measure": "node scripts/measure.mjs",
    "walk": "node scripts/walk.mjs",
    "journey": "node scripts/journey.mjs",
    "typed": "node scripts/typedpath.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "race": "node scripts/race.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "pyodide": "314.0.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.3",
    "jspdf": "4.2.1",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "2.9.0"
